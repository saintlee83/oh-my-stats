{
  "name": "oh-my-stats",
  "version": "0.1.0",
  "description": "The ultimate developer stats platform: sign in with GitHub and track AI tokens and contributions continuously, across every machine.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saintlee83/oh-my-stats.git"
  },
  "homepage": "https://github.com/saintlee83/oh-my-stats#readme",
  "bugs": "https://github.com/saintlee83/oh-my-stats/issues",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "db:local": "wrangler d1 migrations apply DB --local",
    "deploy": "vite build && wrangler deploy --config dist/server/wrangler.json",
    "types": "wrangler types",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --import ./test/register.mjs --test test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.app.json"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitejs/plugin-rsc": "0.5.39",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vite": "8.3.8",
    "wrangler": "^4.167.0"
  },
  "dependencies": {
    "@vinext/cloudflare": "1.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "vinext": "1.4.6"
  }
}
