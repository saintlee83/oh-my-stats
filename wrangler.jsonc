{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "oh-my-stats",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-09",
  // One address only, so GitHub's OAuth callback and session cookies stay on a single origin.
  "routes": [{ "pattern": "ohmystats.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // Without this, `wrangler dev` tells the Worker it's running at the address above.
  "dev": { "port": 8787, "host": "localhost:8787" },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "vars": {
    "GITHUB_CLIENT_ID": "Iv23li0QBpHa6q9Tf3zI"
  },
  // Approximate, per location. The strict one is for sign-in, which calls GitHub, and uploads, which write.
  "ratelimits": [
    { "name": "RATE_LIMIT_PUBLIC", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "RATE_LIMIT_STRICT", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oh-my-stats",
      "database_id": "7d1e9ed9-a97f-43ac-8d71-5bfe368f86b1",
      "migrations_dir": "migrations"
    }
  ]
}
